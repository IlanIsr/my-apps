# Monorepo-wide env defaults. Copy to `.env` at the repo root and fill in.
# Loaded by every app via `@repo/env/load` (imported in each next.config.js).
# Only values SHARED by several apps belong here. App-specific values (each
# app's DATABASE_URL in particular) go in that app's own apps/<name>/.env,
# which overrides anything set here.
#
# In production these are set per deployment (Vercel project env vars), not committed.

# Clerk — all apps share ONE instance (same keys) so sessions carry across
# apps. Google + Apple are enabled in the Clerk dashboard, not here.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# app-1 anniversaries — the shared Google Calendar (anniversaries.calendar@gmail.com).
# The app authenticates AS this account with a stored refresh token:
#   - GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET: a Google Cloud OAuth 2.0 Web client
#     (can be the same one used for Clerk's Google connection)
#   - GOOGLE_REFRESH_TOKEN: from a one-time OAuth consent by the bot account,
#     with scope https://www.googleapis.com/auth/calendar.events
#     (events-only; the app never touches calendars, ACLs, or settings)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Which calendar the events live on (default: the bot account's primary, i.e. prod).
# Non-prod (local + Vercel Preview) must use a separate calendar created in the
# bot account (Google Calendar → "Create new calendar"), so tests never touch
# prod events. Use its calendar ID (Settings → Integrate calendar).
# GOOGLE_CALENDAR_ID=primary

# DATABASE_URL — NOT here. app-1's goes in apps/app-1/.env (Neon project
# "anniversaries", branch preprod), panini's in apps/panini/.env (Neon project
# "panini", branch preprod). drizzle-kit + the migration scripts read those.

# app-1 anniversaries — emails treated as the shared "super user" (comma-separated).
# They see per-card member counts and the "Family on this date" list; everyone else
# doesn't. Defaults to the shared bot account when unset.
# ANNIVERSARIES_ADMIN_EMAILS=anniversaries.calendar@gmail.com

# app-1 anniversaries — PRE-PROD ONLY. A read-only Neon connection string for the
# PRODUCTION database. Set only on the pre-prod deployment: it enables the
# Admin > "Copy from production" button (copies the persons collection prod →
# this env). Prod never has this set; the sync refuses if it equals DATABASE_URL.
# PROD_DATABASE_URL=

# app-1 /contact — emails the owner via Resend (https://resend.com, free tier).
# The Resend account belongs to anniversaries.calendar@gmail.com, with the
# domain anniversaries.dev verified (DNS at Cloudflare), so mail is sent from
# contact@anniversaries.dev to any address. RESEND_API_KEY: a "Sending access"
# key (Vercel Production + Preview).
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=ilanbellaichepro@gmail.com
# CONTACT_FROM="Anniversaries <contact@anniversaries.dev>"
