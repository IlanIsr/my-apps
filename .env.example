# Monorepo-wide env defaults. Copy to `.env` at the repo root and fill in.
# Loaded by every app via `@repo/env/load` (imported in each next.config.js).
# An app's own apps/<name>/.env.local overrides anything set here.
#
# In production these are set per App Hosting backend instead, not committed.

# Clerk — all apps share ONE instance (same keys) so sessions carry across
# apps. Google + Apple are enabled in the Clerk dashboard, not here.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# app-1 anniversaries — the shared Google Calendar (anniversaries.calendar@gmail.com).
# The app authenticates AS this account with a stored refresh token:
#   - GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET: a Google Cloud OAuth 2.0 Web client
#     (can be the same one used for Clerk's Google connection)
#   - GOOGLE_REFRESH_TOKEN: from a one-time OAuth consent by the bot account,
#     with scope https://www.googleapis.com/auth/calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Which calendar the events live on (default: the bot account's primary).
# GOOGLE_CALENDAR_ID=primary
